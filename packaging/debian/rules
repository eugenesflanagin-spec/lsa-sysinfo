#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# the Makefile reads CFLAGS only: pass the hardening CPPFLAGS (_FORTIFY_SOURCE) with them
override_dh_auto_build:
	$(MAKE) CC=gcc CFLAGS="$(CPPFLAGS) $(CFLAGS)" native

override_dh_auto_install:
	$(MAKE) CC=gcc DESTDIR=$(CURDIR)/debian/lsa-sysinfo SYSPREFIX=/usr install-system
	# the licence text is in debian/copyright (Debian policy 12.5)
	rm -rf $(CURDIR)/debian/lsa-sysinfo/usr/share/licenses

# CHANGELOG.md stays in /usr/share/doc/lsa-sysinfo/ (the user guide lists it there);
# a copy is also installed as the Debian upstream changelog.gz
override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

# the programs open /usr/share/doc/lsa-sysinfo/LSA-User-Guide.pdf#dest and
# html/LSA-User-Guide.html#dest by name: the guide tree must stay uncompressed
override_dh_compress:
	dh_compress -X.pdf -X.html -X.md -X.png -X.tsv

override_dh_auto_clean:
	$(MAKE) clean
